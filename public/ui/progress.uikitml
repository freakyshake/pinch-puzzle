<!--
  Progress panel behind the puzzle table. PuzzleSystem drives the element IDs
  board-label, board-name, placed-text, bar-fill, header and step-1..step-6.
  The header and steps use explicit colors so they read the same in both
  color schemes; text on the Panel surface has a dark default and a :dark
  variant because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .header {
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 26px;
    padding-right: 26px;
    background-color: #2b2f3a;
  }

  .eyebrow {
    color: #f5d90a;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }

  .heading {
    color: #fafaf7;
    font-size: 40px;
    font-weight: 700;
    line-height: 48px;
  }

  .steps {
    flex-direction: row;
    justify-content: center;
    gap: 12px;
    padding-top: 22px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .step {
    width: 52px;
    height: 14px;
    border-radius: 7px;
    background-color: #6b6f78;
  }

  .count {
    color: #1c1d20;
    font-size: 26px;
    font-weight: 700;
    padding-top: 16px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .count:dark {
    color: #fafaf7;
  }

  .bar {
    flex-direction: row;
    height: 16px;
    border-radius: 8px;
    margin-top: 10px;
    margin-left: 26px;
    margin-right: 26px;
    margin-bottom: 14px;
    background-color: #6b6f78;
  }

  .bar-fill {
    width: 0%;
    height: 16px;
    border-radius: 8px;
    background-color: #f5d90a;
  }

  .hint {
    color: #3a3b40;
    font-size: 20px;
    padding-left: 26px;
    padding-right: 26px;
    margin-bottom: 18px;
  }

  .hint:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div id="header" class="header">
    <span id="board-label" class="eyebrow">BOARD 1 OF 6</span>
    <span id="board-name" class="heading">First Light</span>
  </div>
  <div class="steps">
    <div id="step-1" class="step"></div>
    <div id="step-2" class="step"></div>
    <div id="step-3" class="step"></div>
    <div id="step-4" class="step"></div>
    <div id="step-5" class="step"></div>
    <div id="step-6" class="step"></div>
  </div>
  <span id="placed-text" class="count">0 of 3 placed</span>
  <div class="bar">
    <div id="bar-fill" class="bar-fill"></div>
  </div>
  <span id="hint" class="hint">Pinch a shape. Drop it on its match.</span>
  <Button id="play-again" class="button" style="display: none">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel class="button-label">Play again</ButtonLabel>
  </Button>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
